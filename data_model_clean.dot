  [label=" article (userinteraction)"] [arrowhead=none, arrowtail=dot, dir=both];

  main_models_GroupMessage -> main_models_Group
  [label=" group (messages)"] [arrowhead=none, arrowtail=dot, dir=both];

  main_models_GroupMessage -> main_models_Article
  [label=" article (group_messages)"] [arrowhead=none, arrowtail=dot, dir=both];

  main_models_GroupMessage -> main_models_GroupMessage
  [label=" parent (replies)"] [arrowhead=none, arrowtail=dot, dir=both];

