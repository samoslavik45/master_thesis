digraph model_graph {
  // Dotfile by Django-Extensions graph_models
  // Created: 2026-04-20 00:52
  // Cli Options: main --group-models --inheritance --disable-fields --include-models Article,Category,Keyword,Tag,Author,ArticleLike,Group,GroupArticleLike,GroupInvite,UserArticleTag,ArticleMetadata,ArticleEmbedding,UserInteraction,RecommendationCache,GroupMessage,GroupNotification --dot -o data_model_clean.dot

  fontname = "Roboto"
  fontsize = 8
  splines  = true
  rankdir = "TB"
  

